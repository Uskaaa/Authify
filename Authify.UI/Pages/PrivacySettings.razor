@page "/privacy-settings"
@using Microsoft.AspNetCore.Components.Web
@using Authify.Core.Common
@using Microsoft.JSInterop
@using Microsoft.Extensions.Localization

@layout ProfileLayout
@inject IJSRuntime JS
@inject IAuthifyDataService DataService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<PrivacySettings> Loc

@if (_showNotification)
{
    var isSuccess = _notificationClass.Contains("green");
    var isError = _notificationClass.Contains("red");
    var alertVariant = isSuccess ? "alert-success" : isError ? "alert-error" : "alert-info";
    <div class="auth-fixed auth-top-20 auth-right-4 auth-z-[10000] auth-max-w-sm auth-transform auth-transition-all auth-duration-300 alert @alertVariant auth-animate-fade-in-down"
         style="box-shadow:0 8px 24px rgba(0,0,0,0.25);">
        <i class="fa-solid @(isSuccess ? "fa-circle-check" : isError ? "fa-circle-xmark" : "fa-circle-info") auth-mt-0.5"></i>
        <span class="auth-font-medium">@_notificationMessage</span>
    </div>
}

<div class="auth-px-4 lg:auth-px-6 auth-py-4 sm:auth-py-6 lg:auth-py-8 auth-min-h-screen" style="background:var(--bg);">
    <div class="auth-max-w-7xl auth-space-y-6">
        @*<div class="auth-flex auth-flex-col sm:auth-flex-row sm:auth-items-center auth-justify-between auth-gap-4">
            <div>
                <h1 class="heading-4" style="color:var(--text-primary);">
                    @Loc["Title_Page"]
                </h1>
                <p class="auth-mt-1 auth-text-sm" style="color:var(--text-secondary);">
                    @Loc["Subtitle_Page"]
                </p>
            </div>
        </div>*@
        
        <div class="auth-mb-8 card-surface" style="padding:0;overflow:hidden;">

            <div class="auth-px-8 auth-py-6 auth-border-b" style="border-color:var(--border);">
                <div class="auth-flex auth-items-center auth-justify-between">
                    <div>
                        <h3 class="auth-text-lg auth-font-bold" style="color:var(--text-primary);">@Loc["Title_MainCard"]</h3>
                        <p class="auth-mt-1 auth-text-sm" style="color:var(--text-secondary);">@Loc["Text_MainCardDesc"]</p>
                    </div>
                    <div class="auth-flex-shrink-0">
                        <div class="auth-w-10 auth-h-10 auth-rounded-lg auth-flex auth-items-center auth-justify-center" style="background:var(--accent-subtle);">
                            <svg class="auth-w-5 auth-h-5" style="color:var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <div class="auth-px-8 auth-py-8 auth-space-y-8">

                <div class="auth-space-y-6">
                    <div class="auth-flex auth-items-center auth-space-x-3">
                        <div class="auth-w-8 auth-h-8 auth-rounded-lg auth-flex auth-items-center auth-justify-center" style="background:var(--accent-subtle);">
                            <svg class="auth-w-4 auth-h-4" style="color:var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="auth-text-base auth-font-semibold" style="color:var(--text-primary);">@Loc["Title_Export"]</h4>
                            <p class="auth-text-sm" style="color:var(--text-secondary);">@Loc["Text_ExportDesc"]</p>
                        </div>
                    </div>

                    <div class="alert alert-info" style="align-items:flex-start;">
                        <svg class="auth-w-5 auth-h-5 auth-mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                        </svg>
                        <div class="auth-flex-1">
                            <h6 class="auth-text-sm auth-font-medium" style="color:var(--text-primary);">@Loc["Title_ExportInfo"]</h6>
                            <ul class="auth-text-sm auth-mt-2 auth-space-y-1 auth-list-disc auth-list-inside">
                                <li>@Loc["List_Export_1"]</li>
                                <li>@Loc["List_Export_2"]</li>
                                <li>@Loc["List_Export_3"]</li>
                                <li>@Loc["List_Export_4"]</li>
                                <li>@Loc["List_Export_5"]</li>
                            </ul>
                            <p class="auth-text-xs auth-mt-3" style="color:var(--text-muted);">@Loc["Text_ExportNote"]</p>
                        </div>
                    </div>

                    <button @onclick="ExportData" disabled="@_isExporting" class="btn-ghost auth-w-full" style="color:var(--accent);border-color:var(--accent-subtle);">
                        @if (_isExporting)
                        {
                            <i class="fa-solid fa-circle-notch fa-spin"></i> <span>@Loc["Btn_Exporting"]</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-download"></i>
                            <span>@Loc["Btn_Export"]</span>
                        }
                    </button>
                </div>

                <div class="auth-border-t" style="border-color:var(--border);"></div>

                <div class="auth-space-y-6">
                    <div class="auth-flex auth-items-center auth-space-x-3">
                        <div class="auth-w-8 auth-h-8 auth-rounded-lg auth-flex auth-items-center auth-justify-center" style="background:var(--warning-subtle);">
                            <svg class="auth-w-4 auth-h-4" style="color:var(--warning);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="auth-text-base auth-font-semibold" style="color:var(--text-primary);">@Loc["Title_Deactivate"]</h4>
                            <p class="auth-text-sm" style="color:var(--text-secondary);">@Loc["Text_DeactivateDesc"]</p>
                        </div>
                    </div>

                    <div class="alert alert-warning" style="align-items:flex-start;">
                        <svg class="auth-w-5 auth-h-5 auth-mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                        </svg>
                        <div class="auth-flex-1">
                            <h6 class="auth-text-sm auth-font-medium" style="color:var(--text-primary);">@Loc["Title_DeactivateInfo"]</h6>
                            <ul class="auth-text-sm auth-mt-2 auth-space-y-1 auth-list-disc auth-list-inside">
                                <li>@Loc["List_Deactivate_1"]</li>
                                <li>@Loc["List_Deactivate_2"]</li>
                                <li>@Loc["List_Deactivate_3"]</li>
                                <li>@Loc["List_Deactivate_4"]</li>
                                <li>@Loc["List_Deactivate_5"]</li>
                            </ul>
                            <p class="auth-text-xs auth-mt-3" style="color:var(--text-muted);">@Loc["Text_DeactivateNote"]</p>
                        </div>
                    </div>

                    <button @onclick="OpenDeactivateModal" class="btn-ghost auth-w-full" style="color:var(--warning);border-color:var(--warning-subtle);">
                        <i class="fa-solid fa-power-off"></i>
                        @Loc["Btn_Deactivate"]
                    </button>
                </div>

                <div class="auth-border-t" style="border-color:var(--border);"></div>

                <div class="auth-space-y-6">
                    <div class="auth-flex auth-items-center auth-space-x-3">
                        <div class="auth-w-8 auth-h-8 auth-rounded-lg auth-flex auth-items-center auth-justify-center" style="background:var(--danger-subtle);">
                            <svg class="auth-w-4 auth-h-4" style="color:var(--danger);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="auth-text-base auth-font-semibold" style="color:var(--text-primary);">@Loc["Title_Delete"]</h4>
                            <p class="auth-text-sm" style="color:var(--text-secondary);">@Loc["Text_DeleteDesc"]</p>
                        </div>
                    </div>

                    <div class="alert alert-error" style="align-items:flex-start;">
                        <svg class="auth-w-5 auth-h-5 auth-mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                        </svg>
                        <div class="auth-flex-1">
                            <h6 class="auth-text-sm auth-font-medium" style="color:var(--text-primary);">@Loc["Title_DeleteInfo"]</h6>
                            <ul class="auth-text-sm auth-mt-2 auth-space-y-1 auth-list-disc auth-list-inside">
                                <li>@Loc["List_Delete_1"]</li>
                                <li>@Loc["List_Delete_2"]</li>
                                <li>@Loc["List_Delete_3"]</li>
                                <li>@Loc["List_Delete_4"]</li>
                                <li>@Loc["List_Delete_5"]</li>
                            </ul>
                            <p class="auth-text-xs auth-mt-3 auth-font-medium" style="color:var(--danger);">@Loc["Text_DeleteNote"]</p>
                        </div>
                    </div>

                    <button id="delete-account-btn" @onclick="OpenDeleteModal" class="btn-primary auth-w-full" style="background:var(--danger);color:#fff;">
                        <i class="fa-solid fa-trash"></i>
                        @Loc["Btn_DeletePermanently"]
                    </button>
                </div>

                <div class="auth-pt-8 auth-border-t" style="border-color:var(--border);">
                    <div class="auth-p-5" style="background:var(--bg-elevated);border:1px solid var(--border);border-radius:var(--radius-md);">
                        <div class="auth-flex auth-items-center">
                            <svg class="auth-w-5 auth-h-5 auth-mr-3" style="color:var(--text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <div>
                                <h5 class="auth-text-sm auth-font-semibold" style="color:var(--text-primary);">@Loc["Title_NeedHelp"]</h5>
                                <p class="auth-text-xs auth-mt-1" style="color:var(--text-secondary);">
                                    @Loc["Text_HelpDesc"]
                                    <a href="#" class="auth-font-medium" style="color:var(--accent);">@Loc["Link_ContactSupport"]</a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (_showDeactivateModal)
{
    <div class="auth-fixed auth-inset-0 auth-z-50 auth-flex auth-items-center auth-justify-center auth-px-4" style="background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);" role="dialog" aria-modal="true" @onclick="CloseDeactivateModal">
        <div class="auth-w-full sm:auth-max-w-lg card-surface" style="padding:0;overflow:hidden;" @onclick:stopPropagation="true">
            <div class="auth-p-6">
                <div class="auth-flex auth-items-start auth-gap-4">
                    <div class="auth-flex-shrink-0 auth-flex auth-items-center auth-justify-center auth-h-10 auth-w-10 auth-rounded-full" style="background:var(--warning-subtle);">
                        <svg class="auth-h-5 auth-w-5" style="color:var(--warning);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="heading-3" style="font-size:1.05rem;">@Loc["Modal_Deactivate_Title"]</h3>
                        <p class="auth-text-sm auth-mt-1" style="color:var(--text-secondary);">
                            @Loc["Modal_Deactivate_Text"]
                        </p>
                    </div>
                </div>
            </div>
            <div class="auth-px-6 auth-py-4 auth-flex auth-justify-end auth-gap-3" style="background:var(--bg-elevated);border-top:1px solid var(--border);">
                <button type="button" @onclick="CloseDeactivateModal" class="btn-ghost">
                    @Loc["Modal_Btn_Cancel"]
                </button>
                <button type="button" @onclick="ConfirmDeactivate" class="btn-primary" style="background:var(--warning);color:#fff;">
                    @Loc["Modal_Btn_Deactivate"]
                </button>
            </div>
        </div>
    </div>
}

@if (_showDeleteModal)
{
    <div class="auth-fixed auth-inset-0 auth-z-50 auth-flex auth-items-center auth-justify-center auth-px-4" style="background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);" role="dialog" aria-modal="true" @onclick="CloseDeleteModal">
        <div class="auth-w-full sm:auth-max-w-lg card-surface" style="padding:0;overflow:hidden;" @onclick:stopPropagation="true">
            <div class="auth-p-6">
                <div class="auth-flex auth-items-start auth-gap-4">
                    <div class="auth-flex-shrink-0 auth-flex auth-items-center auth-justify-center auth-h-10 auth-w-10 auth-rounded-full" style="background:var(--danger-subtle);">
                        <svg class="auth-h-5 auth-w-5" style="color:var(--danger);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="heading-3" style="font-size:1.05rem;">@Loc["Modal_Delete_Title"]</h3>
                        <p class="auth-text-sm auth-mt-1" style="color:var(--text-secondary);">
                            @Loc["Modal_Delete_Text"]
                        </p>
                    </div>
                </div>
            </div>
            <div class="auth-px-6 auth-py-4 auth-flex auth-justify-end auth-gap-3" style="background:var(--bg-elevated);border-top:1px solid var(--border);">
                <button type="button" @onclick="CloseDeleteModal" class="btn-ghost">
                    @Loc["Modal_Btn_Cancel"]
                </button>
                <button type="button" @onclick="ConfirmDelete" class="btn-primary" style="background:var(--danger);color:#fff;">
                    @Loc["Modal_Btn_Delete"]
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _showDeactivateModal = false;
    private bool _showDeleteModal = false;
    private bool _isExporting = false;
    
    private bool _showNotification = false;
    private string _notificationMessage = "";
    private string _notificationClass = "auth-bg-green-500 auth-text-white";

    private IJSObjectReference? _downloadModule;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try {
                await JS.InvokeVoidAsync("applyTheme");
                _downloadModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Authify.UI/js/downloadHelper.js");
            } catch { }
        }
    }

    private async Task ExportData()
    {
        _isExporting = true;
        var result = await DataService.RequestExportAsync();
        
        if (result.Success && result.Data != null)
        {
            var base64 = Convert.ToBase64String(result.Data);
            if (_downloadModule != null)
            {
                await _downloadModule.InvokeVoidAsync("downloadFileFromBase64", "user_export.json", base64);
            }
            ShowNotification(Loc["Msg_ExportStarted"], "auth-bg-green-500");
        }
        else
        {
            ShowNotification(result.ErrorMessage ?? Loc["Msg_ExportFailed"], "auth-bg-red-500");
        }
        _isExporting = false;
    }

    private void OpenDeactivateModal() => _showDeactivateModal = true;
    private void CloseDeactivateModal() => _showDeactivateModal = false;

    private async Task ConfirmDeactivate()
    {
        var result = await DataService.DeactivateAccountAsync();
        if (result.Success)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
        else
        {
             CloseDeactivateModal();
             ShowNotification(result.ErrorMessage ?? Loc["Msg_DeactivateFailed"], "auth-bg-red-500");
        }
    }

    private void OpenDeleteModal() => _showDeleteModal = true;
    private void CloseDeleteModal() => _showDeleteModal = false;

    private async Task ConfirmDelete()
    {
        var result = await DataService.DeleteAccountAsync();
        if (result.Success)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
        else
        {
             CloseDeleteModal();
             ShowNotification(result.ErrorMessage ?? Loc["Msg_DeleteFailed"], "auth-bg-red-500");
        }
    }
    
    private void ShowNotification(string message, string cssClass)
    {
        _notificationMessage = message;
        _notificationClass = cssClass + " auth-text-white";
        _showNotification = true;
        StateHasChanged();
        
        var timer = new System.Threading.Timer((_) =>
        {
            _showNotification = false;
            InvokeAsync(StateHasChanged);
        }, null, 3000, System.Threading.Timeout.Infinite);
    }
}
