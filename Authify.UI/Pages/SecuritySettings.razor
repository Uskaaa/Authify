@page "/security-settings"
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using Authify.Core.Common
@using Microsoft.JSInterop
@using Microsoft.Extensions.Localization
@layout ProfileLayout
@inject IJSRuntime JS
@inject IAuthifyDataService DataService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SecuritySettings> Loc

@if (_showNotification)
{
    var isSuccess = _notificationClass.Contains("green");
    var isInfo = _notificationClass.Contains("blue") || _notificationClass.Contains("gray");
    var alertVariant = isSuccess ? "alert-success" : isInfo ? "alert-info" : "alert-error";
    <div class="auth-fixed auth-top-20 auth-right-4 auth-z-[10000] auth-max-w-sm auth-transform auth-transition-all auth-duration-300 alert @alertVariant auth-animate-fade-in-down"
         style="box-shadow:0 8px 24px rgba(0,0,0,0.25);">
        <i class="fa-solid @(isSuccess ? "fa-circle-check" : isInfo ? "fa-circle-info" : "fa-circle-exclamation") auth-mt-0.5"></i>
        <span class="auth-font-medium">@_notificationMessage</span>
    </div>
}

<div class="auth-space-y-6">
        @*<div class="auth-flex auth-flex-col sm:auth-flex-row sm:auth-items-center auth-justify-between auth-gap-4">
            <div>
                <h1 class="heading-4" style="color:var(--text-primary);">
                    @Loc["Title_Page"]
                </h1>
                <p class="auth-mt-1 auth-text-sm" style="color:var(--text-secondary);">
                    @Loc["Subtitle_Page"]
                </p>
            </div>
        </div>*@
        
        <div class="auth-mb-8 card-surface" style="padding:0;overflow:hidden;">
            <div class="auth-px-8 auth-py-6 auth-border-b" style="border-color:var(--border);">
                <div class="auth-flex auth-items-center auth-justify-between">
                    <div>
                        <h3 class="auth-text-lg auth-font-bold" style="color:var(--text-primary);">@Loc["Title_ChangePassword"]</h3>
                        <p class="auth-mt-1 auth-text-sm" style="color:var(--text-secondary);">@Loc["Text_ChangePasswordDesc"]</p>
                    </div>
                    <div class="auth-flex-shrink-0">
                        <div class="auth-w-10 auth-h-10 auth-rounded-lg auth-flex auth-items-center auth-justify-center" style="background:var(--accent-subtle);">
                            <svg class="auth-w-5 auth-h-5" style="color:var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="auth-px-8 auth-py-8">
                <EditForm Model="@_passwordModel" OnValidSubmit="UpdatePassword" FormName="PasswordForm" method="post">
                    <DataAnnotationsValidator />
                    
                    <div class="auth-grid auth-grid-cols-1 auth-gap-y-6 auth-gap-x-8 lg:auth-grid-cols-2">
                        <div>
                            <label class="label-caption" style="display:block;margin-bottom:0.5rem;">
                                @Loc["Label_CurrentPassword"] <span style="color:var(--danger);">*</span>
                            </label>
                            <input type="password" id="current-password" name="current-password"
                                   @bind="_passwordModel.CurrentPassword"
                                   class="input-field"
                                   placeholder="@Loc["Placeholder_CurrentPassword"]" />
                            <ValidationMessage For="@(() => _passwordModel.CurrentPassword)" class="auth-text-xs auth-mt-1" style="color:var(--danger);" />
                        </div>

                        <div>
                            <label class="label-caption" style="display:block;margin-bottom:0.5rem;">
                                @Loc["Label_NewPassword"] <span style="color:var(--danger);">*</span>
                            </label>
                            <input type="password" id="new-password" name="new-password"
                                   @bind="_passwordModel.NewPassword"
                                   class="input-field"
                                   placeholder="@Loc["Placeholder_NewPassword"]" />
                            <ValidationMessage For="@(() => _passwordModel.NewPassword)" class="auth-text-xs auth-mt-1" style="color:var(--danger);" />

                            <div class="auth-mt-4 auth-space-y-3">
                                <div class="auth-flex auth-justify-between auth-text-xs">
                                    <span style="color:var(--text-muted);">@Loc["Label_Strength"]</span>
                                    <span id="strength-text" class="auth-font-medium" style="color:var(--text-secondary);"></span>
                                </div>
                                <div class="auth-w-full" style="background:var(--bg-elevated);border-radius:var(--radius-sm);height:0.375rem;">
                                    <div id="strength-bar" class="auth-transition-all auth-duration-300" style="width:0%;height:0.375rem;background:var(--text-muted);border-radius:var(--radius-sm);"></div>
                                </div>
                                <ul class="auth-text-xs auth-space-y-1.5" style="color:var(--text-muted);">
                                    <li id="length-check" class="auth-flex auth-items-center auth-transition-colors auth-duration-200">
                                        <svg class="auth-w-3 auth-h-3 auth-mr-2" style="color:var(--text-muted);opacity:0.6;" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                                        @Loc["Check_Length"]
                                    </li>
                                    <li id="uppercase-check" class="auth-flex auth-items-center auth-transition-colors auth-duration-200">
                                        <svg class="auth-w-3 auth-h-3 auth-mr-2" style="color:var(--text-muted);opacity:0.6;" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                                        @Loc["Check_Uppercase"]
                                    </li>
                                    <li id="special-check" class="auth-flex auth-items-center auth-transition-colors auth-duration-200">
                                        <svg class="auth-w-3 auth-h-3 auth-mr-2" style="color:var(--text-muted);opacity:0.6;" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                                        @Loc["Check_Special"]
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="auth-flex auth-flex-col sm:auth-flex-row sm:auth-items-center sm:auth-justify-between auth-pt-6 auth-border-t auth-mt-8" style="border-color:var(--border);">
                        <div class="auth-flex auth-items-center auth-text-sm auth-mb-4 sm:auth-mb-0" style="color:var(--text-secondary);">
                            <i class="fa-solid fa-lock auth-mr-2" style="color:var(--accent);"></i>
                            @Loc["Text_UpdateInfo"]
                        </div>
                        <div class="auth-flex auth-flex-col sm:auth-flex-row sm:auth-items-center auth-space-y-3 sm:auth-space-y-0 sm:auth-space-x-3 auth-w-full sm:auth-w-auto">
                            <button type="button" class="btn-ghost auth-w-full sm:auth-w-auto">
                                @Loc["Btn_Cancel"]
                            </button>
                            <button type="submit" disabled="@_isSaving" class="btn-primary auth-w-full sm:auth-w-auto">
                                @if (_isSaving) { <span>@Loc["Btn_Updating"]</span> } else { <span>@Loc["Btn_UpdatePassword"]</span> }
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>

        <div class="auth-mb-8 card-surface" style="padding:0;overflow:hidden;">
            <div class="auth-px-8 auth-py-6 auth-border-b" style="border-color:var(--border);background:var(--bg-elevated);">
                <div class="auth-flex auth-items-center auth-justify-between">
                    <div>
                        <h3 class="auth-text-lg auth-font-bold" style="color:var(--text-primary);">@Loc["Title_2FA"]</h3>
                        <p class="auth-mt-1 auth-text-sm" style="color:var(--text-secondary);">@Loc["Text_2FADesc"]</p>
                    </div>
                    <div class="auth-flex-shrink-0">
                        <div class="auth-w-10 auth-h-10 auth-rounded-lg auth-flex auth-items-center auth-justify-center" style="background:var(--accent-subtle);">
                            <svg class="auth-w-5 auth-h-5" style="color:var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <div class="auth-px-8 auth-py-8 auth-space-y-6">
                <div class="auth-flex auth-flex-col sm:auth-flex-row sm:auth-items-center sm:auth-justify-between auth-p-5" style="background:var(--bg-elevated);border:1px solid var(--border);border-radius:var(--radius-md);">
                    <div class="auth-flex-1 auth-mb-4 sm:auth-mb-0">
                        <h5 class="auth-text-sm auth-font-semibold" style="color:var(--text-primary);">@Loc["Title_Enable2FA"]</h5>
                        <p class="auth-text-xs auth-mt-1" style="color:var(--text-secondary);">@Loc["Text_Enable2FADesc"]</p>
                    </div>
                    <div class="auth-flex-shrink-0 sm:auth-ml-6">
                        <button @onclick="OpenTwoFaDialog" class="btn-ghost auth-w-full sm:auth-w-auto" style="height:2.25rem;padding:0 1rem;font-size:0.8125rem;">
                            @Loc["Btn_Manage2FA"]
                        </button>
                    </div>
                </div>

                <div class="alert @(_activeTwoFaMethods.Any() ? "alert-success" : "alert-error")">
                    <i class="auth-mt-0.5 @(_activeTwoFaMethods.Any() ? "fa-solid fa-circle-check" : "fa-solid fa-circle-xmark")"></i>
                    <div>
                        @if (_activeTwoFaMethods.Any())
                        {
                            <h6 class="auth-text-sm auth-font-bold">@Loc["Status_2FA_Enabled"]</h6>
                            <p class="auth-text-xs auth-mt-1">@string.Format(Loc["Status_2FA_Enabled_Desc"], _activeTwoFaMethods.Count)</p>
                        }
                        else
                        {
                            <h6 class="auth-text-sm auth-font-bold">@Loc["Status_2FA_Disabled"]</h6>
                            <p class="auth-text-xs auth-mt-1">@Loc["Status_2FA_Disabled_Desc"]</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="auth-mb-8 card-surface" style="padding:0;overflow:hidden;">
            <div class="auth-px-8 auth-py-6 auth-border-b" style="border-color:var(--border);background:var(--bg-elevated);">
                <div class="auth-flex auth-items-center auth-justify-between">
                    <div>
                        <h3 class="auth-text-lg auth-font-bold" style="color:var(--text-primary);">@Loc["Title_Connected"]</h3>
                        <p class="auth-mt-1 auth-text-sm" style="color:var(--text-secondary);">@Loc["Text_ConnectedDesc"]</p>
                    </div>
                    <div class="auth-flex-shrink-0">
                        <div class="auth-w-10 auth-h-10 auth-rounded-lg auth-flex auth-items-center auth-justify-center" style="background:var(--accent-subtle);">
                            <svg class="auth-w-5 auth-h-5" style="color:var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <div class="auth-px-8 auth-py-8 auth-space-y-4">
                @if (_isLoadingProviders)
                {
                    <div class="auth-flex auth-justify-center auth-p-4">
                        <i class="fa-solid fa-circle-notch fa-spin auth-text-2xl" style="color:var(--accent);"></i>
                    </div>
                }
                else
                {
                    @foreach (var provider in _providers)
                    {
                        <div class="auth-flex auth-items-center auth-justify-between auth-p-4" style="background:var(--bg-elevated);border:1px solid var(--border);border-radius:var(--radius-md);">
                            <div class="auth-flex auth-items-center auth-space-x-4">
                                <div class="auth-w-10 auth-h-10 @provider.BgClass auth-rounded-full auth-flex auth-items-center auth-justify-center auth-text-lg @provider.TextClass">
                                    <i class="@provider.Icon"></i>
                                </div>
                                <div>
                                    <h5 class="auth-text-sm auth-font-bold" style="color:var(--text-primary);">@provider.Name</h5>
                                    <p class="auth-text-xs" style="color:var(--text-secondary);">
                                        @(provider.IsConnected ? Loc["Status_Connected"] : Loc["Status_NotConnected"])
                                    </p>
                                </div>
                            </div>
                            <button @onclick="() => ToggleProvider(provider)" class="btn-ghost" style="height:2rem;padding:0 0.875rem;font-size:0.75rem;@(provider.IsConnected ? "color:var(--danger);border-color:var(--danger-subtle);" : "")">
                                @(provider.IsConnected ? Loc["Btn_Disconnect"] : Loc["Btn_Connect"])
                            </button>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

@if (_showTwoFaDialog)
{
    <div class="auth-fixed auth-inset-0 auth-z-[9999] auth-overflow-y-auto" role="dialog" aria-modal="true">
        <div class="auth-flex auth-items-center auth-justify-center auth-min-h-screen auth-p-4 auth-text-center">
            <div class="auth-fixed auth-inset-0 auth-transition-opacity" style="background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);" @onclick="CloseTwoFaDialog"></div>

            <div class="auth-relative auth-max-w-2xl auth-w-full auth-max-h-[90vh] auth-overflow-hidden card-surface" style="padding:0;">

                <div class="auth-px-6 auth-py-4 auth-border-b auth-flex auth-justify-between auth-items-center" style="background:var(--bg-elevated);border-color:var(--border);">
                    <h3 class="auth-text-lg auth-font-bold" style="color:var(--text-primary);">@Loc["Dialog_2FA_Title"]</h3>
                    <button @onclick="CloseTwoFaDialog" class="focus:auth-outline-none" style="color:var(--text-secondary);background:none;border:none;cursor:pointer;">
                        <i class="fa-solid fa-xmark auth-text-lg"></i>
                    </button>
                </div>

                <div class="auth-px-6 auth-py-6 auth-max-h-[60vh] auth-overflow-y-auto auth-space-y-6">
                    <div>
                        <h4 class="eyebrow auth-mb-3">@Loc["Section_ActiveMethods"]</h4>
                        <div class="auth-space-y-3">
                            @foreach(var method in _activeTwoFaMethods)
                            {
                                <div class="auth-flex auth-items-center auth-justify-between auth-p-4" style="background:var(--bg-surface);border:1px solid var(--border);border-radius:var(--radius-md);">
                                    <div class="auth-flex auth-items-center auth-gap-4">
                                        <div class="auth-w-10 auth-h-10 @method.BgClass auth-rounded-full auth-flex auth-items-center auth-justify-center @method.TextClass">
                                            @((MarkupString)method.IconSvg)
                                        </div>
                                        <div class="auth-text-left">
                                            <h5 class="auth-text-sm auth-font-bold" style="color:var(--text-primary);">@Loc[method.NameKey]</h5>
                                            <p class="auth-text-xs" style="color:var(--text-secondary);">@Loc[method.DescKey]</p>
                                        </div>
                                    </div>

                                    <div class="auth-flex auth-items-center auth-gap-2">
                                        @if(method.Priority == 0)
                                        {
                                            <span class="badge badge-success auth-hidden sm:auth-inline-flex">@Loc["Badge_Default"]</span>
                                        }
                                        else if(_activeTwoFaMethods.Count > 1)
                                        {
                                            <button @onclick="() => SetDefaultTwoFa(method)" class="btn-ghost auth-hidden sm:auth-inline-flex" style="height:1.875rem;padding:0 0.75rem;font-size:0.75rem;">
                                                @Loc["Btn_SetDefault"]
                                            </button>
                                        }

                                        <button @onclick="() => RemoveTwoFa(method)" class="btn-ghost" style="height:1.875rem;padding:0 0.75rem;font-size:0.75rem;color:var(--danger);border-color:var(--danger-subtle);">
                                            @Loc["Btn_Remove"]
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    @if(_availableTwoFaMethods.Any())
                    {
                        <div>
                            <h4 class="eyebrow auth-mb-3">@Loc["Section_AvailableMethods"]</h4>
                            <div class="auth-space-y-3">
                                @foreach(var method in _availableTwoFaMethods)
                                {
                                    <div class="auth-flex auth-items-center auth-justify-between auth-p-4" style="background:var(--bg-elevated);border:1px solid var(--border);border-radius:var(--radius-md);">
                                        <div class="auth-flex auth-items-center auth-gap-4">
                                            <div class="auth-w-10 auth-h-10 @method.BgClass auth-rounded-full auth-flex auth-items-center auth-justify-center @method.TextClass">
                                                @((MarkupString)method.IconSvg)
                                            </div>
                                            <div class="auth-text-left">
                                                <h5 class="auth-text-sm auth-font-bold" style="color:var(--text-primary);">@Loc[method.NameKey]</h5>
                                                <p class="auth-text-xs" style="color:var(--text-secondary);">@Loc[method.DescKey]</p>
                                            </div>
                                        </div>
                                        <button @onclick="() => AddTwoFa(method)" class="btn-ghost" style="height:1.875rem;padding:0 0.75rem;font-size:0.75rem;">
                                            @Loc["Btn_Add"]
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ChangePasswordRequest _passwordModel = new();
    private bool _showTwoFaDialog = false;
    private IJSObjectReference? _module;
    private bool _isSaving = false;

    // Notification
    private bool _showNotification = false;
    private string _notificationMessage = "";
    private string _notificationClass = "auth-bg-green-500 auth-text-white";

    // Listen
    private List<SessionModel> _sessions = new();
    private List<ExternalProvider> _providers = new();
    private bool _isLoadingProviders = false;

    // 2FA Listen
    private List<TwoFaUiModel> _allSupportedMethods = new();
    private List<TwoFaUiModel> _activeTwoFaMethods = new();
    private List<TwoFaUiModel> _availableTwoFaMethods = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("applyTheme");
        
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Authify.UI/js/security-page.js");
            await _module.InvokeVoidAsync("init");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        
        var provider = query.GetValueOrDefault("provider").ToString();
        var key = query.GetValueOrDefault("key").ToString();
        var displayName = query.GetValueOrDefault("display").ToString();
        var error = query.GetValueOrDefault("error").ToString();

        if (!string.IsNullOrEmpty(provider) && !string.IsNullOrEmpty(key) && !string.IsNullOrEmpty(displayName))
        {
            var externalProvider = new ConnectExternalLoginRequest
            {
                LoginProvider = provider,
                ProviderKey = key,
                ProviderDisplayName = displayName
            };
            
            var result = await DataService.ConnectProviderAsync(externalProvider);
            
            if (result.Success)
                NavigationManager.NavigateTo("/security-settings", replace: true);
        }
        else if (!string.IsNullOrEmpty(error))
        {
            ShowNotification(Loc["Msg_ConnectFailed"], "auth-bg-red-500");
        }
        
        // Initialisierung der 2FA Methoden mit angepassten Klassen (Prefixes)
        _allSupportedMethods = new List<TwoFaUiModel>
        {
            new TwoFaUiModel 
            { 
                MethodType = TwoFactorMethod.Email, 
                NameKey = "Method_Email_Name", 
                DescKey = "Method_Email_Desc", 
                IconSvg = "<svg class='auth-w-5 auth-h-5' fill='currentColor' viewBox='0 0 20 20'><path d='M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z'></path><path d='M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z'></path></svg>",
                BgClass = "auth-bg-orange-100 dark:auth-bg-orange-900/50",
                TextClass = "auth-text-orange-600 dark:auth-text-orange-400"
            },
            new TwoFaUiModel 
            { 
                MethodType = TwoFactorMethod.Sms, 
                NameKey = "Method_SMS_Name", 
                DescKey = "Method_SMS_Desc", 
                IconSvg = "<svg class='auth-w-5 auth-h-5' fill='currentColor' viewBox='0 0 20 20'><path d='M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z'></path></svg>",
                BgClass = "auth-bg-green-100 dark:auth-bg-green-900/50",
                TextClass = "auth-text-green-600 dark:auth-text-green-400"
            }
        };
        
        await LoadExternalProviders();
        await LoadTwoFaStatus();
    }

    // --- PROVIDER LOGIC ---
    private async Task LoadExternalProviders()
    {
        _isLoadingProviders = true;
        _providers.Clear();
        // Updated Classes with auth- prefix
        _providers.Add(new ExternalProvider { Name = "Google",   LoginProvider = "Google",   Icon = "fa-brands fa-google",   BgClass = "auth-bg-red-100 dark:auth-bg-red-900/50",   TextClass = "auth-text-red-600 dark:auth-text-red-400" });
        _providers.Add(new ExternalProvider { Name = "GitHub",   LoginProvider = "GitHub",   Icon = "fa-brands fa-github",   BgClass = "auth-bg-gray-100 dark:auth-bg-gray-700",     TextClass = "auth-text-gray-800 dark:auth-text-gray-200" });
        // _providers.Add(new ExternalProvider { Name = "Facebook", LoginProvider = "Facebook", Icon = "fa-brands fa-facebook", BgClass = "auth-bg-blue-100 dark:auth-bg-blue-900/50", TextClass = "auth-text-blue-600 dark:auth-text-blue-400" });

        var result = await DataService.GetConnectedProvidersAsync();

        if (result.Success && result.Data != null)
        {
            var connectedProviders = result.Data
                .Select(c => c.LoginProvider)
                .ToList();

            foreach (var p in _providers)
            {
                p.IsConnected = connectedProviders.Contains(p.LoginProvider);
            }
        }

        _isLoadingProviders = false;
        StateHasChanged();
    }

    private async Task ToggleProvider(ExternalProvider provider)
    {
        if (provider.IsConnected)
        {
            var result = await DataService.DisconnectProviderAsync(provider.LoginProvider);
            if (result.Success) 
            {
                provider.IsConnected = false;
                ShowNotification(string.Format(Loc["Msg_ProviderDisconnected"], provider.Name), "auth-bg-blue-500");
            }
            else ShowNotification(result.ErrorMessage ?? Loc["Msg_DisconnectFailed"], "auth-bg-red-500");
        }
        else
        {
            var accessToken = await DataService.GetAccessTokenAsync();
            NavigationManager.NavigateTo($"/auth/external-login?provider={provider.LoginProvider}&returnUrl=/security-settings&mode=connect&access_token={accessToken}", forceLoad: true);
        }
    }

    // --- 2FA LOGIC ---
    private async Task LoadTwoFaStatus()
    {
        var result = await DataService.GetAllAsync();
        _activeTwoFaMethods.Clear();
        _availableTwoFaMethods.Clear();

        if (result.Success && result.Data != null)
        {
            var user2fa = result.Data;

            foreach(var supported in _allSupportedMethods)
            {
                var active = user2fa.FirstOrDefault(u => u.Method == supported.MethodType && u.IsEnabled);
                var model = supported.Clone();
                if (active != null)
                {
                    model.Priority = active.Priority;
                    model.IsEnabled = true;
                    _activeTwoFaMethods.Add(model);
                }
                else
                {
                    model.IsEnabled = false;
                    _availableTwoFaMethods.Add(model);
                }
            }

            _activeTwoFaMethods.Sort((x, y) => x.Priority.CompareTo(y.Priority));
        }
        else
        {
            foreach (var m in _allSupportedMethods)
            {
                var model = m.Clone();
                model.IsEnabled = false;
                _availableTwoFaMethods.Add(model);
            }
        }
        await InvokeAsync(StateHasChanged);
    }


    private async Task AddTwoFa(TwoFaUiModel method)
    {
        var request = new TwoFactorRequest
        {
            TwoFactorMethod = method.MethodType,
            IsEnabled = true,
            Priority = _activeTwoFaMethods.Count == 0 ? 0 : 10
        };
        
        var result = await DataService.AddOrUpdateAsync(request);
        if(result.Success)
        {
            ShowNotification(Loc["Msg_MethodAdded"], "auth-bg-green-500");
            await LoadTwoFaStatus();
        }
        else ShowNotification(result.ErrorMessage ?? Loc["Msg_AddFailed"], "auth-bg-red-500");
    }

    private async Task RemoveTwoFa(TwoFaUiModel method)
    {
        var request = new TwoFactorRequest { TwoFactorMethod = method.MethodType };
        var result = await DataService.RemoveAsync(request);
        if(result.Success)
        {
             ShowNotification(Loc["Msg_MethodRemoved"], "auth-bg-blue-500");
             await LoadTwoFaStatus();
        }
        else ShowNotification(result.ErrorMessage ?? Loc["Msg_RemoveFailed"], "auth-bg-red-500");
    }

    private async Task SetDefaultTwoFa(TwoFaUiModel method)
    {
        var request = new TwoFactorRequest
        {
            TwoFactorMethod = method.MethodType,
            IsEnabled = true,
            Priority = 0
        };
        
        var result = await DataService.AddOrUpdateAsync(request);
        if(result.Success)
        {
             ShowNotification(Loc["Msg_DefaultUpdated"], "auth-bg-green-500");
             await LoadTwoFaStatus();
        }
        else ShowNotification(result.ErrorMessage ?? Loc["Msg_DefaultFailed"], "auth-bg-red-500");
    }

    // --- PASSWORD LOGIC ---
    private async Task UpdatePassword()
    {
        _isSaving = true;
        var result = await DataService.ChangePasswordAsync(_passwordModel);
        _isSaving = false;
        
        if (result.Success)
        {
            ShowNotification(Loc["Msg_PasswordUpdated"], "auth-bg-green-500");
            _passwordModel = new();
        }
        else
        {
            ShowNotification(result.ErrorMessage ?? Loc["Msg_PasswordUpdateFailed"], "auth-bg-red-500");
        }
    }

    // --- UI HELPERS ---
    private void OpenTwoFaDialog() => _showTwoFaDialog = true;
    private void CloseTwoFaDialog() => _showTwoFaDialog = false;

    private void ShowNotification(string message, string cssClass)
    {
        _notificationMessage = message;
        _notificationClass = cssClass + " auth-text-white";
        _showNotification = true;
        StateHasChanged();
        var timer = new System.Threading.Timer((_) => { _showNotification = false; InvokeAsync(StateHasChanged); }, null, 3000, System.Threading.Timeout.Infinite);
    }
    
