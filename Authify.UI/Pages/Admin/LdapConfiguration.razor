@page "/admin/ldap"
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]
@layout ProfileLayout

@inject ILdapDataService LdapDataService
@inject ITeamDataService TeamDataService
@inject LdapFeatureOptions LdapFeature
@inject TeamFeatureOptions TeamFeature
@inject NavigationManager NavigationManager

<div class="auth-px-4 lg:auth-px-6 auth-py-4 sm:auth-py-6 lg:auth-py-8 auth-min-h-screen" style="background:var(--bg);">
<div class="auth-max-w-7xl auth-space-y-6">

    @if (!LdapFeature.IsEnabled)
    {
        <div class="auth-text-center auth-py-16" style="color:var(--text-muted);">LDAP-Features sind nicht aktiviert.</div>
    }

    <div class="auth-mb-8">
        <h1 class="heading-3" style="font-size:1.5rem;">LDAP / Active Directory</h1>
        <p class="auth-mt-1 auth-text-sm" style="color:var(--text-secondary);">
            Verbinde dein Unternehmensverzeichnis, damit sich Mitarbeiter mit ihren Domänen-Accounts anmelden können.
        </p>
    </div>

    @if (_isLoading)
    {
        <div class="auth-flex auth-items-center auth-justify-center auth-py-16">
            <i class="fa-solid fa-spinner fa-spin auth-text-2xl" style="color:var(--accent);"></i>
        </div>
    }

    @if (!_hasTeam)
    {
        <div class="card-surface auth-text-center" style="border-color:var(--warning-subtle);">
            <i class="fa-solid fa-building auth-text-4xl auth-mb-3" style="color:var(--warning);"></i>
            <p class="auth-font-medium" style="color:var(--text-primary);">Du musst zuerst einen Team-Account erstellen.</p>
            <p class="auth-text-sm auth-mt-1 auth-mb-4" style="color:var(--text-secondary);">LDAP-Konfigurationen gehören zu deinem Team.</p>
            <button class="btn-primary" @onclick='() => NavigationManager.NavigateTo("/admin/team-settings")'>
                Team erstellen
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success auth-mb-6">
            <i class="fa-solid fa-circle-check auth-mt-0.5"></i>
            <p>@_successMessage</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-error auth-mb-6">
            <i class="fa-solid fa-circle-exclamation auth-mt-0.5"></i>
            <p>@_errorMessage</p>
        </div>
    }

    @* ── Liste bestehender Konfigurationen ──────────────────────────────── *@
    @if (_configurations.Count > 0)
    {
        <div class="auth-space-y-3 auth-mb-8">
            @foreach (var cfg in _configurations)
            {
                <div class="card-surface">
                    <div class="auth-flex auth-items-start auth-justify-between auth-gap-4">
                        <div class="auth-flex-1 auth-min-w-0">
                            <div class="auth-flex auth-items-center auth-gap-2 auth-mb-1">
                                <span class="auth-font-semibold" style="color:var(--text-primary);">@cfg.Domain</span>
                                @if (cfg.IsEnabled)
                                {
                                    <span class="badge badge-success">
                                        <i class="fa-solid fa-circle auth-text-[8px]"></i> Aktiv
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-neutral">
                                        <i class="fa-solid fa-circle auth-text-[8px]"></i> Inaktiv
                                    </span>
                                }
                                @if (cfg.UseSsl)
                                {
                                    <span class="badge badge-info">
                                        <i class="fa-solid fa-lock auth-text-[10px]"></i> SSL
                                    </span>
                                }
                            </div>
                            <p class="auth-text-sm" style="color:var(--text-secondary);">
                                @cfg.Host:@cfg.Port &nbsp;·&nbsp; @cfg.BaseDn
                            </p>
                            <p class="auth-text-xs auth-mt-0.5" style="color:var(--text-muted);">
                                BindDn: @cfg.BindDn &nbsp;·&nbsp; Passwort: @(cfg.HasBindPassword ? "gesetzt" : "nicht gesetzt")
                            </p>
                        </div>
                        <div class="auth-flex auth-items-center auth-gap-2 auth-shrink-0">
                            <button class="btn-ghost" style="height:2rem;padding:0 0.75rem;font-size:0.8125rem;" @onclick="() => StartEdit(cfg)">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            <button class="btn-ghost" style="height:2rem;padding:0 0.75rem;font-size:0.8125rem;color:var(--danger);border-color:var(--danger-subtle);" @onclick="() => ConfirmDelete(cfg)">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* ── Formular: Neu erstellen / Bearbeiten ───────────────────────────── *@
    @if (_showForm)
    {
        <div class="card-surface auth-mb-6">
            <h2 class="auth-text-lg auth-font-semibold auth-mb-5" style="color:var(--text-primary);">
                @(_editingId != null ? "LDAP-Konfiguration bearbeiten" : "Neue LDAP-Konfiguration")
            </h2>

            <div class="auth-grid auth-grid-cols-1 sm:auth-grid-cols-2 auth-gap-4">

                <div class="auth-mb-4 sm:auth-col-span-2">
                    <label class="label-caption" style="display:block;margin-bottom:0.375rem;">E-Mail-Domain <span style="color:var(--danger);">*</span></label>
                    <input class="input-field" @bind="_form.Domain" placeholder="z.B. company.com" />
                    <p style="font-size:0.75rem;color:var(--text-muted);margin-top:0.25rem;">Benutzer mit dieser E-Mail-Domain werden über LDAP authentifiziert.</p>
                </div>

                <div class="auth-mb-4">
                    <label class="label-caption" style="display:block;margin-bottom:0.375rem;">LDAP-Server (Host) <span style="color:var(--danger);">*</span></label>
                    <input class="input-field" @bind="_form.Host" placeholder="dc01.company.com" />
                </div>

                <div class="auth-mb-4">
                    <label class="label-caption" style="display:block;margin-bottom:0.375rem;">Port</label>
                    <input class="input-field" type="number" @bind="_form.Port" />
                </div>

                <div class="auth-mb-4 sm:auth-col-span-2">
                    <label class="label-caption" style="display:block;margin-bottom:0.375rem;">Base DN <span style="color:var(--danger);">*</span></label>
                    <input class="input-field" @bind="_form.BaseDn" placeholder="DC=company,DC=com" />
                </div>

                <div class="auth-mb-4 sm:auth-col-span-2">
                    <label class="label-caption" style="display:block;margin-bottom:0.375rem;">Bind DN (Service-Account) <span style="color:var(--danger);">*</span></label>
                    <input class="input-field" @bind="_form.BindDn" placeholder="CN=ldap-service,OU=ServiceAccounts,DC=company,DC=com" />
                </div>

                <div class="auth-mb-4 sm:auth-col-span-2">
                    <label class="label-caption" style="display:block;margin-bottom:0.375rem;">
                        Bind-Passwort @(_editingId != null ? "(leer lassen = bestehendes Passwort beibehalten)" : "")
                        @if (_editingId == null) { <span style="color:var(--danger);">*</span> }
                    </label>
                    <input class="input-field" type="password" @bind="_form.BindPassword" autocomplete="new-password" />
                </div>

                <div class="auth-mb-4 sm:auth-col-span-2">
                    <label class="label-caption" style="display:block;margin-bottom:0.375rem;">Suchfilter</label>
                    <input class="input-field" @bind="_form.SearchFilter" placeholder="(&(objectClass=user)(mail={0}))" />
                    <p style="font-size:0.75rem;color:var(--text-muted);margin-top:0.25rem;">{0} wird durch die E-Mail-Adresse ersetzt.</p>
                </div>

                <div class="auth-mb-4">
                    <label class="label-caption" style="display:block;margin-bottom:0.375rem;">E-Mail-Attribut</label>
                    <input class="input-field" @bind="_form.EmailAttribute" placeholder="mail" />
                </div>

                <div class="auth-mb-4">
                    <label class="label-caption" style="display:block;margin-bottom:0.375rem;">Anzeigename-Attribut</label>
                    <input class="input-field" @bind="_form.DisplayNameAttribute" placeholder="displayName" />
                </div>

                <label class="switch auth-mb-4">
                    <input type="checkbox" @bind="_form.UseSsl" />
                    <span class="switch-ui" aria-hidden="true"></span>
                    <span class="switch-txt">SSL/TLS verwenden (LDAPS, Port 636)</span>
                </label>

                <label class="switch auth-mb-4">
                    <input type="checkbox" @bind="_form.IsEnabled" />
                    <span class="switch-ui" aria-hidden="true"></span>
                    <span class="switch-txt">Konfiguration aktiv</span>
                </label>
            </div>

            @* Test-Verbindung *@
            <div class="auth-mt-5 auth-pt-5 auth-border-t" style="border-color:var(--border);">
                <div class="auth-flex auth-items-center auth-gap-3 auth-flex-wrap">
                    <button class="btn-ghost" @onclick="TestConnection" disabled="@_isTestingConnection">
                        @if (_isTestingConnection)
                        {
                            <i class="fa-solid fa-spinner fa-spin"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-plug"></i>
                        }
                        Verbindung testen
                    </button>

                    @if (_testResult != null)
                    {
                        @if (_testResult.Success)
                        {
                            <span class="auth-text-sm" style="color:var(--success);">
                                <i class="fa-solid fa-circle-check auth-mr-1"></i>
                                Verbindung erfolgreich (@(_testResult.EntryCount ?? 0) Einträge gefunden)
                            </span>
                        }
                        else
                        {
                            <span class="auth-text-sm" style="color:var(--danger);">
                                <i class="fa-solid fa-circle-xmark auth-mr-1"></i>
                                @_testResult.ErrorMessage
                            </span>
                        }
                    }
                </div>
            </div>

            <div class="auth-flex auth-justify-end auth-gap-3 auth-mt-6">
                <button class="btn-ghost" @onclick="CancelForm">Abbrechen</button>
                <button class="btn-primary" @onclick="SaveConfiguration" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <i class="fa-solid fa-spinner fa-spin"></i>
                    }
                    @(_editingId != null ? "Speichern" : "Erstellen")
                </button>
            </div>
        </div>
    }

    @if (!_showForm)
    {
        <button class="btn-primary" @onclick="StartCreate">
            <i class="fa-solid fa-plus"></i>
            LDAP-Konfiguration hinzufügen
        </button>
    }

    @* ── Löschen-Bestätigung ─────────────────────────────────────────────── *@
    @if (_confirmDeleteId != null)
    {
        <div class="auth-fixed auth-inset-0 auth-z-50 auth-flex auth-items-center auth-justify-center auth-px-4" style="background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);">
            <div class="card-surface auth-max-w-sm auth-w-full">
                <h3 class="heading-3" style="font-size:1.05rem;margin-bottom:0.5rem;">LDAP-Konfiguration löschen?</h3>
                <p class="auth-text-sm auth-mb-6" style="color:var(--text-secondary);">
                    Domain: <strong>@_confirmDeleteDomain</strong><br />
                    Bereits JIT-provisionierte Benutzer bleiben erhalten, können sich aber nicht mehr per LDAP anmelden.
                </p>
                <div class="auth-flex auth-gap-3 auth-justify-end">
                    <button class="btn-ghost" @onclick="() => _confirmDeleteId = null">Abbrechen</button>
                    <button class="btn-primary" style="background:var(--danger);color:#fff;" @onclick="DeleteConfiguration" disabled="@_isSaving">
                        @if (_isSaving) { <i class="fa-solid fa-spinner fa-spin"></i> }
                        Löschen
                    </button>
                </div>
            </div>
        </div>
    }
</div>
</div>

@code {
    private bool _isLoading = true;
    private bool _hasTeam = false;
    private bool _showForm = false;
    private bool _isSaving = false;
    private bool _isTestingConnection = false;
    private string? _successMessage;
    private string? _errorMessage;

    private List<LdapConfigurationDto> _configurations = [];

    // Form state
    private string? _editingId;
    private LdapFormModel _form = new();

    // Test connection result
    private LdapTestConnectionResult? _testResult;

    // Delete confirmation
    private string? _confirmDeleteId;
    private string? _confirmDeleteDomain;

    protected override async Task OnInitializedAsync()
    {
        var teamResult = await TeamDataService.GetMyTeamAsync();
        _hasTeam = teamResult.Success;

        if (_hasTeam)
        {
            var cfgResult = await LdapDataService.GetConfigurationsAsync();
            if (cfgResult.Success) _configurations = cfgResult.Data ?? [];
        }

        _isLoading = false;
    }

    private void StartCreate()
    {
        _editingId = null;
        _form = new LdapFormModel();
        _testResult = null;
        _showForm = true;
        ClearMessages();
    }

    private void StartEdit(LdapConfigurationDto cfg)
    {
        _editingId = cfg.Id;
        _form = new LdapFormModel
        {
            Domain = cfg.Domain,
            Host = cfg.Host,
            Port = cfg.Port,
            UseSsl = cfg.UseSsl,
            BindDn = cfg.BindDn,
            BaseDn = cfg.BaseDn,
            SearchFilter = cfg.SearchFilter,
            EmailAttribute = cfg.EmailAttribute,
            DisplayNameAttribute = cfg.DisplayNameAttribute,
            IsEnabled = cfg.IsEnabled
            // BindPassword bleibt leer — zeigt an "bestehendes Passwort behalten"
        };
        _testResult = null;
        _showForm = true;
        ClearMessages();
    }

    private void CancelForm()
    {
        _showForm = false;
        _editingId = null;
        _form = new();
        _testResult = null;
    }

    private async Task SaveConfiguration()
    {
        ClearMessages();
        _isSaving = true;

        if (_editingId != null)
        {
            var req = new UpdateLdapConfigurationRequest
            {
                Domain = _form.Domain,
                Host = _form.Host,
                Port = _form.Port,
                UseSsl = _form.UseSsl,
                BindDn = _form.BindDn,
                BindPassword = string.IsNullOrWhiteSpace(_form.BindPassword) ? null : _form.BindPassword,
                BaseDn = _form.BaseDn,
                SearchFilter = _form.SearchFilter,
                EmailAttribute = _form.EmailAttribute,
                DisplayNameAttribute = _form.DisplayNameAttribute,
                IsEnabled = _form.IsEnabled
            };
            var result = await LdapDataService.UpdateConfigurationAsync(_editingId, req);
            if (result.Success)
            {
                var idx = _configurations.FindIndex(c => c.Id == _editingId);
                if (idx >= 0 && result.Data != null) _configurations[idx] = result.Data;
                _successMessage = "Konfiguration gespeichert.";
                CancelForm();
            }
            else
            {
                _errorMessage = result.ErrorMessage;
            }
        }
        else
        {
            var req = new CreateLdapConfigurationRequest
            {
                Domain = _form.Domain,
                Host = _form.Host,
                Port = _form.Port,
                UseSsl = _form.UseSsl,
                BindDn = _form.BindDn,
                BindPassword = _form.BindPassword,
                BaseDn = _form.BaseDn,
                SearchFilter = _form.SearchFilter,
                EmailAttribute = _form.EmailAttribute,
                DisplayNameAttribute = _form.DisplayNameAttribute,
                IsEnabled = _form.IsEnabled
            };
            var result = await LdapDataService.CreateConfigurationAsync(req);
            if (result.Success)
            {
                if (result.Data != null) _configurations.Add(result.Data);
                _successMessage = $"LDAP-Konfiguration für Domain '{req.Domain}' erstellt.";
                CancelForm();
            }
            else
            {
                _errorMessage = result.ErrorMessage;
            }
        }

        _isSaving = false;
    }

    private void ConfirmDelete(LdapConfigurationDto cfg)
    {
        _confirmDeleteId = cfg.Id;
        _confirmDeleteDomain = cfg.Domain;
        ClearMessages();
    }

    private async Task DeleteConfiguration()
    {
        if (_confirmDeleteId == null) return;
        _isSaving = true;

        var result = await LdapDataService.DeleteConfigurationAsync(_confirmDeleteId);
        if (result.Success)
        {
            _configurations.RemoveAll(c => c.Id == _confirmDeleteId);
            _successMessage = $"LDAP-Konfiguration für '{_confirmDeleteDomain}' gelöscht.";
        }
        else
        {
            _errorMessage = result.ErrorMessage;
        }

        _confirmDeleteId = null;
        _isSaving = false;
    }

    private async Task TestConnection()
    {
        _isTestingConnection = true;
        _testResult = null;

        var req = new LdapTestConnectionRequest
        {
            Host = _form.Host,
            Port = _form.Port,
            UseSsl = _form.UseSsl,
            BindDn = _form.BindDn,
            BindPassword = string.IsNullOrWhiteSpace(_form.BindPassword) ? null : _form.BindPassword,
            ExistingConfigId = string.IsNullOrWhiteSpace(_form.BindPassword) ? _editingId : null,
            BaseDn = _form.BaseDn
        };
        _testResult = await LdapDataService.TestConnectionAsync(req);
        _isTestingConnection = false;
    }

    private void ClearMessages()
    {
        _successMessage = null;
        _errorMessage = null;
    }

    private class LdapFormModel
    {
        public string Domain { get; set; } = string.Empty;
        public string Host { get; set; } = string.Empty;
        public int Port { get; set; } = 389;
        public bool UseSsl { get; set; } = false;
        public string BindDn { get; set; } = string.Empty;
        public string BindPassword { get; set; } = string.Empty;
        public string BaseDn { get; set; } = string.Empty;
        public string SearchFilter { get; set; } = "(&(objectClass=user)(mail={0}))";
        public string EmailAttribute { get; set; } = "mail";
        public string DisplayNameAttribute { get; set; } = "displayName";
        public bool IsEnabled { get; set; } = true;
    }
}
