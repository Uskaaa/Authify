@page "/admin/team-settings"
@using Microsoft.AspNetCore.Authorization
@using Authify.Core.Features
@using Authify.Core.Interfaces
@using Authify.Core.Models.Teams
@using Authify.UI.Services

@attribute [Authorize]
@layout ProfileLayout

@inject ITeamDataService TeamDataService
@inject TeamFeatureOptions TeamFeature
@inject NavigationManager NavigationManager
@inject TeamNavStateService TeamNavState

<div class="auth-space-y-6">

    @if (!TeamFeature.IsEnabled)
    {
        <div class="auth-text-center auth-py-16" style="color:var(--text-muted);">Team-Features sind nicht aktiviert.</div>
        return;
    }

    <div class="auth-mb-8">
        <h1 class="heading-3" style="font-size:1.5rem;">Team-Account</h1>
        <p class="auth-mt-1 auth-text-sm" style="color:var(--text-secondary);">Verwalte dein Unternehmensteam</p>
    </div>

    @if (_isLoading)
    {
        <div class="auth-flex auth-items-center auth-justify-center auth-py-16">
            <i class="fa-solid fa-spinner fa-spin auth-text-2xl" style="color:var(--accent);"></i>
        </div>
    }
    else if (_team == null)
    {
        <!-- Kein Team vorhanden -->
        <div class="card-surface auth-text-center">
            <div class="auth-w-16 auth-h-16 auth-rounded-lg auth-flex auth-items-center auth-justify-center auth-mx-auto auth-mb-4" style="background:var(--accent-subtle);">
                <i class="fa-solid fa-building auth-text-2xl" style="color:var(--accent);"></i>
            </div>
            <h2 class="auth-text-lg auth-font-semibold auth-mb-2" style="color:var(--text-primary);">Noch kein Team erstellt</h2>
            <p class="auth-text-sm auth-mb-6" style="color:var(--text-secondary);">
                Erstelle einen Team-Account um Mitarbeiter einzuladen und gemeinsam zu arbeiten.
            </p>
            <button @onclick="() => _showCreateForm = true" class="btn-primary">
                <i class="fa-solid fa-plus"></i>
                Team erstellen
            </button>
        </div>
    }
    else
    {
        <!-- Team vorhanden – Bearbeiten -->
        <div class="card-surface auth-mb-4">
            <div class="auth-flex auth-items-center auth-justify-between auth-mb-4">
                <h2 class="auth-text-base auth-font-semibold" style="color:var(--text-primary);">Team-Informationen</h2>
                <span class="auth-text-xs" style="color:var(--text-secondary);">@_team.MemberCount Mitglied(er)</span>
            </div>
            <EditForm Model="_updateRequest" OnValidSubmit="HandleUpdate" FormName="UpdateTeamForm">
                <DataAnnotationsValidator />
                @FormFields(_updateRequest)
                <div class="auth-flex auth-gap-3 auth-mt-4">
                    <button type="submit" disabled="@_isSaving" class="btn-primary auth-flex-1">
                        @if (_isSaving) { <i class="fa-solid fa-spinner fa-spin"></i> }
                        Speichern
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="alert alert-success auth-mt-3">@_successMessage</div>
                }
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-error auth-mt-3">@_errorMessage</div>
                }
            </EditForm>
        </div>

        <!-- Danger Zone -->
        <div class="card-surface" style="border-color:var(--danger-subtle);">
            <h3 class="auth-text-sm auth-font-semibold auth-mb-2" style="color:var(--danger);">Gefahrenbereich</h3>
            <p class="auth-text-xs auth-mb-4" style="color:var(--text-muted);">
                Das Löschen des Teams entfernt alle Mitglieder und Einladungen unwiderruflich.
            </p>
            @if (!_showDeleteConfirm)
            {
                <button @onclick="() => _showDeleteConfirm = true" class="btn-ghost" style="color:var(--danger);border-color:var(--danger-subtle);">
                    Team löschen
                </button>
            }
            else
            {
                <div class="auth-space-y-3">
                    <p class="auth-text-sm auth-font-medium" style="color:var(--text-secondary);">Bist du sicher? Diese Aktion kann nicht rückgängig gemacht werden.</p>
                    <div class="auth-flex auth-gap-3">
                        <button @onclick="HandleDelete" disabled="@_isSaving" class="btn-primary" style="background:var(--danger);color:#fff;">
                            @if (_isSaving) { <i class="fa-solid fa-spinner fa-spin"></i> }
                            Ja, Team löschen
                        </button>
                        <button @onclick="() => _showDeleteConfirm = false" class="btn-ghost">
                            Abbrechen
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (_showCreateForm)
{
    <div class="auth-fixed auth-inset-0 auth-z-[9999] auth-overflow-y-auto" role="dialog" aria-modal="true">
        <div class="auth-flex auth-items-center auth-justify-center auth-min-h-screen auth-p-4">
            <div class="auth-fixed auth-inset-0 auth-transition-opacity" style="background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);" @onclick="CloseCreateForm"></div>

            <div class="auth-relative auth-max-w-lg auth-w-full card-surface" style="padding:0;">
                <div class="auth-px-6 auth-py-4 auth-border-b auth-flex auth-justify-between auth-items-center" style="background:var(--bg-elevated);border-color:var(--border);">
                    <h3 class="auth-text-lg auth-font-bold" style="color:var(--text-primary);">Neues Team erstellen</h3>
                    <button type="button" @onclick="CloseCreateForm" style="color:var(--text-secondary);background:none;border:none;cursor:pointer;">
                        <i class="fa-solid fa-xmark auth-text-lg"></i>
                    </button>
                </div>
                <EditForm Model="_createRequest" OnValidSubmit="HandleCreate" FormName="CreateTeamForm">
                    <DataAnnotationsValidator />
                    <div class="auth-px-6 auth-py-6">
                        @FormFields(_createRequest)
                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <div class="alert alert-error auth-mt-4">@_errorMessage</div>
                        }
                    </div>
                    <div class="auth-px-6 auth-py-4 auth-border-t auth-flex auth-justify-end auth-gap-3" style="background:var(--bg-elevated);border-color:var(--border);">
                        <button type="button" @onclick="CloseCreateForm" class="btn-ghost">Abbrechen</button>
                        <button type="submit" disabled="@_isSaving" class="btn-primary">
                            @if (_isSaving) { <i class="fa-solid fa-spinner fa-spin"></i> }
                            Team erstellen
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private TeamDto? _team;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _showCreateForm;
    private bool _showDeleteConfirm;
    private string? _errorMessage;
    private string? _successMessage;

    private CreateTeamRequest _createRequest = new();
    private UpdateTeamRequest _updateRequest = new();

    protected override async Task OnInitializedAsync()
    {
        if (!TeamFeature.IsEnabled) return;
        await LoadTeamAsync();
    }

    private async Task LoadTeamAsync()
    {
        _isLoading = true;
        var result = await TeamDataService.GetMyTeamAsync();
        if (result.Success && result.Data != null)
        {
            _team = result.Data;
            _updateRequest = new UpdateTeamRequest
            {
                Name = _team.Name,
                Description = _team.Description,
                CompanyAddress = _team.CompanyAddress,
                Website = _team.Website
            };
        }
        _isLoading = false;
    }

    private async Task HandleCreate()
    {
        _isSaving = true;
        _errorMessage = null;
        var result = await TeamDataService.CreateTeamAsync(_createRequest);
        _isSaving = false;
        if (result.Success)
        {
            _showCreateForm = false;
            await LoadTeamAsync();
            TeamNavState.NotifyTeamChanged();
        }
        else
        {
            _errorMessage = result.ErrorMessage;
        }
    }

    private void CloseCreateForm()
    {
        _showCreateForm = false;
        _errorMessage = null;
    }

    private async Task HandleUpdate()
    {
        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;
        var result = await TeamDataService.UpdateTeamAsync(_updateRequest);
        _isSaving = false;
        if (result.Success)
        {
            _team = result.Data;
            _successMessage = "Team erfolgreich gespeichert.";
            await Task.Delay(3000);
            _successMessage = null;
        }
        else
        {
            _errorMessage = result.ErrorMessage;
        }
    }

    private async Task HandleDelete()
    {
        _isSaving = true;
        var result = await TeamDataService.DeleteTeamAsync();
        _isSaving = false;
        if (result.Success)
        {
            _team = null;
            _showDeleteConfirm = false;
            TeamNavState.NotifyTeamChanged();
        }
        else
        {
            _errorMessage = result.ErrorMessage;
        }
    }

    private RenderFragment FormFields(object model) => __builder =>
    {
        var name = model is CreateTeamRequest c ? c.Name : ((UpdateTeamRequest)model).Name;
        <div class="auth-space-y-4">
            <div class="auth-space-y-1.5">
                <label class="label-caption">Teamname *</label>
                @if (model is CreateTeamRequest cr)
                {
                    <InputText @bind-Value="cr.Name" placeholder="Mein Unternehmen GmbH"
                               class="input-field" />
                    <ValidationMessage For="@(() => cr.Name)" />
                }
                else
                {
                    var ur = (UpdateTeamRequest)model;
                    <InputText @bind-Value="ur.Name" placeholder="Mein Unternehmen GmbH"
                               class="input-field" />
                    <ValidationMessage For="@(() => ur.Name)" />
                }
            </div>
            <div class="auth-space-y-1.5">
                <label class="label-caption">Beschreibung</label>
                @if (model is CreateTeamRequest cr2)
                {
                    <InputTextArea @bind-Value="cr2.Description" rows="3" placeholder="Kurze Beschreibung des Unternehmens..."
                                   class="input-field auth-resize-none" />
                }
                else
                {
                    var ur2 = (UpdateTeamRequest)model;
                    <InputTextArea @bind-Value="ur2.Description" rows="3" placeholder="Kurze Beschreibung des Unternehmens..."
                                   class="input-field auth-resize-none" />
                }
            </div>
            <div class="auth-space-y-1.5">
                <label class="label-caption">Unternehmensadresse</label>
                @if (model is CreateTeamRequest cr3)
                {
                    <InputText @bind-Value="cr3.CompanyAddress" placeholder="Musterstraße 1, 12345 Musterstadt"
                               class="input-field" />
                }
                else
                {
                    var ur3 = (UpdateTeamRequest)model;
                    <InputText @bind-Value="ur3.CompanyAddress" placeholder="Musterstraße 1, 12345 Musterstadt"
                               class="input-field" />
                }
            </div>
            <div class="auth-space-y-1.5">
                <label class="label-caption">Website</label>
                @if (model is CreateTeamRequest cr4)
                {
                    <InputText @bind-Value="cr4.Website" placeholder="https://mein-unternehmen.de"
                               class="input-field" />
                }
                else
                {
                    var ur4 = (UpdateTeamRequest)model;
                    <InputText @bind-Value="ur4.Website" placeholder="https://mein-unternehmen.de"
                               class="input-field" />
                }
            </div>
        </div>
    };
}
