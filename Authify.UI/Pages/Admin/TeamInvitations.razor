@page "/admin/team-invitations"
@using Microsoft.AspNetCore.Authorization
@using Authify.Core.Features
@using Authify.Core.Interfaces
@using Authify.Core.Models.Teams

@attribute [Authorize]
@layout ProfileLayout

@inject ITeamDataService TeamDataService
@inject TeamFeatureOptions TeamFeature
@inject NavigationManager NavigationManager

<div class="auth-space-y-6">

    @if (!TeamFeature.IsEnabled)
    {
        <div class="auth-text-center auth-py-16" style="color:var(--text-muted);">Team-Features sind nicht aktiviert.</div>
        return;
    }

    <div class="auth-flex auth-items-center auth-justify-between auth-mb-8">
        <div>
            <h1 class="heading-3" style="font-size:1.5rem;">Einladungslinks</h1>
            <p class="auth-mt-1 auth-text-sm" style="color:var(--text-secondary);">Erstelle und verwalte Einladungslinks für dein Team</p>
        </div>
        <button @onclick="() => _showCreateForm = !_showCreateForm" class="btn-primary">
            <i class="fa-solid fa-plus"></i>
            Einladung erstellen
        </button>
    </div>

    @if (!_hasTeam)
    {
        <div class="card-surface auth-text-center">
            <i class="fa-solid fa-triangle-exclamation auth-text-3xl auth-mb-3" style="color:var(--warning);"></i>
            <h2 class="auth-text-base auth-font-semibold auth-mb-2" style="color:var(--text-primary);">Kein Team vorhanden</h2>
            <p class="auth-text-sm auth-mb-4" style="color:var(--text-secondary);">Du musst zuerst einen Team-Account erstellen um Einladungslinks zu erzeugen.</p>
            <a href="admin/team-settings" class="btn-primary">
                <i class="fa-solid fa-building"></i>
                Team erstellen
            </a>
        </div>
        return;
    }

    <!-- Formular: Einladung erstellen -->
    @if (_showCreateForm)
    {
        <div class="card-surface auth-mb-6">
            <h3 class="auth-text-base auth-font-semibold auth-mb-4" style="color:var(--text-primary);">Neue Einladung erstellen</h3>
            <EditForm Model="_createRequest" OnValidSubmit="HandleCreate" FormName="CreateInvitationForm">
                <DataAnnotationsValidator />
                <div class="auth-space-y-4">

                    <div class="auth-space-y-1.5">
                        <label class="label-caption">
                            E-Mail (optional – für persönliche Einladungen)
                        </label>
                        <InputText @bind-Value="_createRequest.Email" type="email" placeholder="max@unternehmen.de" class="input-field" />
                        @if (!string.IsNullOrWhiteSpace(_createRequest.Email))
                        {
                            <div class="auth-flex auth-items-center auth-gap-1.5 auth-text-xs auth-mt-1" style="color:var(--accent);">
                                <i class="fa-solid fa-paper-plane"></i>
                                <span>Der Einladungslink wird direkt an diese E-Mail-Adresse gesendet. Der Link kann nur einmal verwendet werden.</span>
                            </div>
                        }
                        else
                        {
                            <p class="auth-text-xs" style="color:var(--text-secondary);">Leer lassen für einen allgemeinen Link, den du selbst weitergibst.</p>
                        }
                    </div>

                    @if (string.IsNullOrWhiteSpace(_createRequest.Email))
                    {
                        <div class="auth-space-y-1.5">
                            <label class="label-caption">
                                Maximale Verwendungen
                            </label>
                            <div class="auth-flex auth-items-center auth-gap-3">
                                <label class="auth-flex auth-items-center auth-gap-2 auth-cursor-pointer">
                                    <input type="checkbox" @bind="_unlimited" style="accent-color:var(--accent);" />
                                    <span class="auth-text-sm" style="color:var(--text-secondary);">Unbegrenzt</span>
                                </label>
                                @if (!_unlimited)
                                {
                                    <InputNumber @bind-Value="_createRequest.MaxUses" min="1" placeholder="z.B. 10" class="input-field" style="width:8rem;" />
                                }
                            </div>
                            <p class="auth-text-xs" style="color:var(--text-muted);">
                                Ohne Angabe oder "Unbegrenzt" kann der Link beliebig oft verwendet werden.
                            </p>
                        </div>
                    }

                    <div class="auth-space-y-1.5">
                        <label class="label-caption">
                            Gültig für (Tage)
                        </label>
                        <InputNumber @bind-Value="_createRequest.ExpirationDays" min="1" max="365" placeholder="z.B. 7" class="input-field" style="width:8rem;" />
                        <p class="auth-text-xs" style="color:var(--text-muted);">Standard: 7 Tage. Leer lassen für kein Ablaufdatum.</p>
                    </div>
                </div>

                <div class="auth-flex auth-gap-3 auth-mt-5">
                    <button type="submit" disabled="@_isSaving" class="btn-primary">
                        @if (_isSaving) { <i class="fa-solid fa-spinner fa-spin"></i> }
                        @(string.IsNullOrWhiteSpace(_createRequest.Email) ? "Einladungslink erstellen" : "Einladung senden")
                    </button>
                    <button type="button" @onclick="() => { _showCreateForm = false; _errorMessage = null; }" class="btn-ghost">
                        Abbrechen
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-error auth-mt-3">@_errorMessage</div>
                }
            </EditForm>
        </div>
    }

    <!-- Frisch erstellter Link-Banner -->
    @if (_newInvitationLink != null)
    {
        <div class="alert alert-success auth-mb-6" style="flex-direction:column;align-items:stretch;">
            <div class="auth-flex auth-items-center auth-gap-2">
                <i class="fa-solid fa-check-circle"></i>
                <span class="auth-font-semibold">
                    @(_newInvitationSentByEmail ? "Einladung per E-Mail gesendet!" : "Einladungslink erstellt!")
                </span>
            </div>
            @if (_newInvitationSentByEmail)
            {
                <p class="auth-text-xs auth-mt-2">
                    Die Einladung wurde direkt an <strong>@_newInvitationEmail</strong> gesendet.
                    Der Link kann nur einmal verwendet werden und ist nur für diese E-Mail-Adresse gültig.
                </p>
            }
            else
            {
                <p class="auth-text-xs auth-mt-2 auth-mb-2">Teile diesen Link mit der Person, die du einladen möchtest:</p>
                <div class="auth-flex auth-items-center auth-gap-2">
                    <code class="auth-flex-1 auth-break-all" style="background:var(--bg-elevated);border:1px solid var(--border);border-radius:var(--radius-sm);padding:0.5rem 0.75rem;color:var(--text-primary);font-size:0.75rem;">
                        @_newInvitationLink
                    </code>
                    <button @onclick="CopyLink" class="btn-ghost auth-flex-shrink-0" style="height:2rem;padding:0 0.75rem;font-size:0.75rem;">
                        @(_copied ? "✓ Kopiert" : "Kopieren")
                    </button>
                </div>
            }
        </div>
    }

    <!-- Einladungsliste -->
    @if (_isLoading)
    {
        <div class="auth-flex auth-items-center auth-justify-center auth-py-12">
            <i class="fa-solid fa-spinner fa-spin auth-text-2xl" style="color:var(--accent);"></i>
        </div>
    }
    else if (_invitations.Count == 0)
    {
        <div class="card-surface auth-text-center">
            <i class="fa-solid fa-link auth-text-3xl auth-mb-3" style="color:var(--text-muted);"></i>
            <p class="auth-text-sm" style="color:var(--text-secondary);">Noch keine Einladungen erstellt.</p>
        </div>
    }
    else
    {
        <div class="card-surface" style="padding:0;overflow:hidden;">
            @foreach (var inv in _invitations)
            {
                <div class="auth-px-5 auth-py-4 auth-border-b last:auth-border-b-0" style="border-color:var(--border);">
                    <div class="auth-flex auth-items-start auth-justify-between auth-gap-4">
                        <div class="auth-flex-1 auth-min-w-0">
                            <div class="auth-flex auth-items-center auth-gap-2 auth-flex-wrap">
                                @if (!string.IsNullOrEmpty(inv.Email))
                                {
                                    <span class="auth-text-sm auth-font-medium" style="color:var(--text-primary);">@inv.Email</span>
                                    <span class="badge badge-info">Persönlich</span>
                                }
                                else
                                {
                                    <span class="auth-text-sm auth-font-medium" style="color:var(--text-primary);">Allgemeine Einladung</span>
                                }
                                @{
                                    var (badgeCss, badgeLabel) = GetStatusBadge(inv);
                                }
                                <span class="badge @badgeCss">@badgeLabel</span>
                            </div>
                            <div class="auth-mt-1.5 auth-flex auth-items-center auth-gap-3 auth-text-xs" style="color:var(--text-muted);">
                                <span>
                                    <i class="fa-solid fa-users auth-mr-1"></i>
                                    @inv.UsedCount / @(inv.MaxUses.HasValue ? inv.MaxUses.ToString() : "∞") Verwendungen
                                </span>
                                @if (inv.ExpiresAt.HasValue)
                                {
                                    <span>
                                        <i class="fa-solid fa-clock auth-mr-1"></i>
                                        Läuft ab: @inv.ExpiresAt.Value.ToString("dd.MM.yyyy")
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="auth-flex auth-items-center auth-gap-2 auth-flex-shrink-0">
                            @if (!inv.IsRevoked && inv.IsValid)
                            {
                                <button @onclick="() => CopyInvitationLink(inv.Token)"
                                        class="auth-p-1.5 auth-transition-colors" style="background:none;border:none;cursor:pointer;color:var(--text-muted);border-radius:var(--radius-sm);"
                                        title="Link kopieren">
                                    <i class="fa-solid fa-copy auth-text-xs"></i>
                                </button>
                            }
                            @if (!inv.IsRevoked)
                            {
                                <button @onclick="() => HandleRevoke(inv.Id)"
                                        class="auth-p-1.5 auth-transition-colors" style="background:none;border:none;cursor:pointer;color:var(--text-muted);border-radius:var(--radius-sm);"
                                        title="Einladung widerrufen">
                                    <i class="fa-solid fa-ban auth-text-xs"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<TeamInvitationDto> _invitations = [];
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _showCreateForm;
    private bool _hasTeam = true;
    private bool _unlimited;
    private bool _copied;
    private string? _errorMessage;
    private string? _newInvitationLink;
    private bool _newInvitationSentByEmail;
    private string? _newInvitationEmail;

    private CreateInvitationRequest _createRequest = new() { ExpirationDays = 7 };

    protected override async Task OnInitializedAsync()
    {
        if (!TeamFeature.IsEnabled) return;

        var teamResult = await TeamDataService.GetMyTeamAsync();
        _hasTeam = teamResult.Success;

        if (_hasTeam)
            await LoadInvitationsAsync();
        else
            _isLoading = false;
    }

    private async Task LoadInvitationsAsync()
    {
        _isLoading = true;
        var result = await TeamDataService.GetInvitationsAsync();
        if (result.Success && result.Data != null)
            _invitations = result.Data;
        _isLoading = false;
    }

    private async Task HandleCreate()
    {
        _isSaving = true;
        _errorMessage = null;
        _newInvitationLink = null;
        _newInvitationSentByEmail = false;
        _newInvitationEmail = null;

        // Bei persönlicher Einladung MaxUses ignorieren (Server erzwingt 1)
        if (!string.IsNullOrWhiteSpace(_createRequest.Email))
            _createRequest.MaxUses = null;
        else if (_unlimited)
            _createRequest.MaxUses = null;

        var result = await TeamDataService.CreateInvitationAsync(_createRequest);
        _isSaving = false;

        if (result.Success && result.Data != null)
        {
            _invitations.Insert(0, result.Data);
            _showCreateForm = false;
            var sentEmail = _createRequest.Email;
            _createRequest = new() { ExpirationDays = 7 };
            _unlimited = false;

            var baseUrl = NavigationManager.BaseUri.TrimEnd('/');
            _newInvitationLink = $"{baseUrl}/accept-invitation?token={result.Data.Token}";

            if (!string.IsNullOrWhiteSpace(sentEmail))
            {
                _newInvitationSentByEmail = true;
                _newInvitationEmail = sentEmail;
            }
        }
        else
        {
            _errorMessage = result.ErrorMessage;
        }
    }

    private async Task HandleRevoke(string invitationId)
    {
        var result = await TeamDataService.RevokeInvitationAsync(invitationId);
        if (result.Success)
        {
            var inv = _invitations.FirstOrDefault(i => i.Id == invitationId);
            if (inv != null) inv.IsRevoked = true;
        }
    }

    private void CopyInvitationLink(string token)
    {
        var baseUrl = NavigationManager.BaseUri.TrimEnd('/');
        _newInvitationLink = $"{baseUrl}/accept-invitation?token={token}";
    }

    private async Task CopyLink()
    {
        // Clipboard-API nur in Browser-Umgebung verfügbar; wir nutzen JS-interop nur wenn nötig.
        // Für jetzt markieren wir visuell als "kopiert" – JS-Interop wäre optional zu ergänzen.
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }

    private (string css, string label) GetStatusBadge(TeamInvitationDto inv)
    {
        if (inv.IsRevoked)
            return ("badge-danger", "Widerrufen");
        if (inv.IsExpired)
            return ("badge-neutral", "Abgelaufen");
        if (inv.MaxUses.HasValue && inv.UsedCount >= inv.MaxUses.Value)
            return ("badge-warning", "Limit erreicht");
        return ("badge-success", "Aktiv");
    }
}
