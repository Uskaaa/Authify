@page "/admin/team-members"
@using Microsoft.AspNetCore.Authorization
@using Authify.Core.Features
@using Authify.Core.Interfaces
@using Authify.Core.Models.Teams

@attribute [Authorize]
@layout ProfileLayout

@inject ITeamDataService TeamDataService
@inject TeamFeatureOptions TeamFeature
@inject NavigationManager NavigationManager

<div class="auth-space-y-6">

    @if (!TeamFeature.IsEnabled)
    {
        <div class="auth-text-center auth-py-16" style="color:var(--text-muted);">Team-Features sind nicht aktiviert.</div>
        return;
    }

    <div class="auth-flex auth-items-center auth-justify-between auth-mb-8 auth-flex-wrap auth-gap-3">
        <div>
            <h1 class="heading-3" style="font-size:1.5rem;">Mitarbeiter</h1>
            <p class="auth-mt-1 auth-text-sm" style="color:var(--text-secondary);">Verwalte die Mitglieder deines Teams</p>
        </div>
        <button @onclick="() => _showAddForm = true" class="btn-primary">
            <i class="fa-solid fa-plus"></i>
            Mitarbeiter hinzufügen
        </button>
    </div>

    @if (_members.Count > 0)
    {
        <div class="auth-relative auth-w-full sm:auth-w-72 auth-mb-6">
            <i class="fa-solid fa-search" style="position:absolute;left:0.875rem;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:0.7rem;pointer-events:none;"></i>
            <input type="text" @bind="_memberSearch" @bind:event="oninput" class="input-field" style="width:100%;padding-left:2.25rem;"
                   placeholder="Mitarbeiter suchen..." />
        </div>
    }

    @if (!_hasTeam)
    {
        <div class="card-surface auth-text-center">
            <i class="fa-solid fa-triangle-exclamation auth-text-3xl auth-mb-3" style="color:var(--warning);"></i>
            <h2 class="auth-text-base auth-font-semibold auth-mb-2" style="color:var(--text-primary);">Kein Team vorhanden</h2>
            <p class="auth-text-sm auth-mb-4" style="color:var(--text-secondary);">Du musst zuerst einen Team-Account erstellen um Mitarbeiter hinzuzufügen.</p>
            <a href="admin/team-settings" class="btn-primary">
                <i class="fa-solid fa-building"></i>
                Team erstellen
            </a>
        </div>
        return;
    }

    <!-- Erfolgs-/Passwort-Banner -->
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert @(_newMemberTempPassword != null ? "alert-warning" : "alert-success") auth-mb-6" style="flex-direction:column;align-items:stretch;">
            <div class="auth-flex auth-items-center auth-gap-2">
                <i class="fa-solid @(_newMemberTempPassword != null ? "fa-triangle-exclamation" : "fa-check-circle")"></i>
                <span class="auth-font-semibold">@_successMessage</span>
            </div>
            @if (_newMemberTempPassword != null)
            {
                <div class="auth-flex auth-items-center auth-gap-2 auth-mt-2">
                    <code class="auth-flex-1 auth-font-mono" style="background:var(--bg-elevated);border:1px solid var(--border);border-radius:var(--radius-sm);padding:0.5rem 0.75rem;color:var(--text-primary);">
                        @_newMemberTempPassword
                    </code>
                    <button @onclick="() => _newMemberTempPassword = null"
                            class="auth-flex-shrink-0" style="background:none;border:none;padding:0.5rem;color:var(--text-muted);cursor:pointer;"
                            title="Schließen">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
                <p class="auth-mt-2 auth-text-xs">
                    <i class="fa-solid fa-circle-info auth-mr-1"></i>
                    Dieses Passwort wird nur einmalig angezeigt. Bitte sicher aufbewahren und dem Mitarbeiter mitteilen.
                </p>
            }
        </div>
    }

    <!-- Mitgliederliste -->
    @if (_isLoading)
    {
        <div class="auth-flex auth-items-center auth-justify-center auth-py-12">
            <i class="fa-solid fa-spinner fa-spin auth-text-2xl" style="color:var(--accent);"></i>
        </div>
    }
    else if (_members.Count == 0)
    {
        <div class="card-surface auth-text-center">
            <i class="fa-solid fa-users auth-text-3xl auth-mb-3" style="color:var(--text-muted);"></i>
            <p class="auth-text-sm" style="color:var(--text-secondary);">Noch keine Mitarbeiter vorhanden.</p>
        </div>
    }
    else if (!FilteredMembers.Any())
    {
        <div class="card-surface auth-text-center">
            <i class="fa-solid fa-magnifying-glass auth-text-3xl auth-mb-3" style="color:var(--text-muted);"></i>
            <p class="auth-text-sm" style="color:var(--text-secondary);">Keine Mitarbeiter gefunden.</p>
        </div>
    }
    else
    {
        <div class="card-surface" style="padding:0;overflow:hidden;">
            @foreach (var member in FilteredMembers)
            {
                <div class="auth-flex auth-items-center auth-justify-between auth-px-5 auth-py-4 auth-border-b last:auth-border-b-0" style="border-color:var(--border);">
                    <div class="auth-flex auth-items-center auth-gap-3">
                        <div class="auth-w-9 auth-h-9 auth-rounded-full auth-flex auth-items-center auth-justify-center auth-flex-shrink-0" style="background:var(--accent-subtle);">
                            <span class="auth-text-sm auth-font-semibold" style="color:var(--accent);">
                                @(member.FullName.Length > 0 ? member.FullName[0].ToString().ToUpper() : "?")
                            </span>
                        </div>
                        <div>
                            <div class="auth-text-sm auth-font-medium" style="color:var(--text-primary);">@member.FullName</div>
                            <div class="auth-text-xs" style="color:var(--text-secondary);">@member.Email</div>
                        </div>
                    </div>
                    <div class="auth-flex auth-items-center auth-gap-3">
                        <span class="badge @(member.Role == TeamMemberRole.Admin ? "badge-info" : "badge-neutral")">
                            @(member.Role == TeamMemberRole.Admin ? "Admin" : "Mitglied")
                        </span>
                        @if (member.Role != TeamMemberRole.Admin)
                        {
                            <button @onclick="() => HandleRemove(member.Id)"
                                    class="auth-p-1.5 auth-transition-colors" style="background:none;border:none;cursor:pointer;color:var(--text-muted);border-radius:var(--radius-sm);"
                                    title="Mitglied entfernen">
                                <i class="fa-solid fa-trash auth-text-xs"></i>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (_showAddForm)
{
    <div class="auth-fixed auth-inset-0 auth-z-[9999] auth-overflow-y-auto" role="dialog" aria-modal="true">
        <div class="auth-flex auth-items-center auth-justify-center auth-min-h-screen auth-p-4">
            <div class="auth-fixed auth-inset-0 auth-transition-opacity" style="background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);" @onclick="CloseAddForm"></div>

            <div class="auth-relative auth-max-w-lg auth-w-full card-surface" style="padding:0;">
                <div class="auth-px-6 auth-py-4 auth-border-b auth-flex auth-justify-between auth-items-center" style="background:var(--bg-elevated);border-color:var(--border);">
                    <h3 class="auth-text-lg auth-font-bold" style="color:var(--text-primary);">Neuen Mitarbeiter anlegen</h3>
                    <button type="button" @onclick="CloseAddForm" style="color:var(--text-secondary);background:none;border:none;cursor:pointer;">
                        <i class="fa-solid fa-xmark auth-text-lg"></i>
                    </button>
                </div>
                <EditForm Model="_createRequest" OnValidSubmit="HandleCreate" FormName="CreateMemberForm">
                    <DataAnnotationsValidator />
                    <div class="auth-px-6 auth-py-6">
                        <div class="auth-space-y-4">
                            <div class="auth-space-y-1.5">
                                <label class="label-caption">Vollständiger Name *</label>
                                <InputText @bind-Value="_createRequest.FullName" placeholder="Max Mustermann" class="input-field" />
                                <ValidationMessage For="@(() => _createRequest.FullName)" />
                            </div>
                            <div class="auth-space-y-1.5">
                                <label class="label-caption">E-Mail-Adresse *</label>
                                <InputText @bind-Value="_createRequest.Email" placeholder="max@unternehmen.de" type="email" class="input-field" />
                                <ValidationMessage For="@(() => _createRequest.Email)" />
                            </div>
                        </div>
                        <p class="auth-mt-3 auth-text-xs" style="color:var(--text-secondary);">
                            Der Mitarbeiter erhält automatisch eine E-Mail mit einem Link zum Passwort festlegen.
                        </p>
                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <div class="alert alert-error auth-mt-4">@_errorMessage</div>
                        }
                    </div>
                    <div class="auth-px-6 auth-py-4 auth-border-t auth-flex auth-justify-end auth-gap-3" style="background:var(--bg-elevated);border-color:var(--border);">
                        <button type="button" @onclick="CloseAddForm" class="btn-ghost">Abbrechen</button>
                        <button type="submit" disabled="@_isSaving" class="btn-primary">
                            @if (_isSaving) { <i class="fa-solid fa-spinner fa-spin"></i> }
                            Mitarbeiter anlegen
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<TeamMemberDto> _members = [];
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _showAddForm;
    private bool _hasTeam = true;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _newMemberTempPassword; // nur befüllt wenn E-Mail-Versand fehlschlug
    private string _memberSearch = "";

    private IEnumerable<TeamMemberDto> FilteredMembers =>
        string.IsNullOrWhiteSpace(_memberSearch)
            ? _members
            : _members.Where(m =>
                m.FullName.Contains(_memberSearch, StringComparison.OrdinalIgnoreCase) ||
                m.Email.Contains(_memberSearch, StringComparison.OrdinalIgnoreCase));

    private CreateTeamMemberRequest _createRequest = new();

    protected override async Task OnInitializedAsync()
    {
        if (!TeamFeature.IsEnabled) return;

        // Prüfen ob Team existiert
        var teamResult = await TeamDataService.GetMyTeamAsync();
        _hasTeam = teamResult.Success;

        if (_hasTeam)
            await LoadMembersAsync();
        else
            _isLoading = false;
    }

    private async Task LoadMembersAsync()
    {
        _isLoading = true;
        var result = await TeamDataService.GetMembersAsync();
        if (result.Success && result.Data != null)
            _members = result.Data;
        _isLoading = false;
    }

    private async Task HandleCreate()
    {
        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;
        _newMemberTempPassword = null;
        var result = await TeamDataService.CreateMemberAsync(_createRequest);
        _isSaving = false;

        if (result.Success && result.Data != null)
        {
            _members.Add(result.Data);
            _createRequest = new();
            _showAddForm = false;

            if (!string.IsNullOrEmpty(result.Data.TemporaryPassword))
            {
                // E-Mail konnte nicht gesendet werden – Passwort dem Admin anzeigen
                _newMemberTempPassword = result.Data.TemporaryPassword;
                _successMessage = $"Mitarbeiter \"{result.Data.FullName}\" wurde angelegt. E-Mail-Versand fehlgeschlagen – bitte Passwort manuell weitergeben:";
            }
            else
            {
                _successMessage = $"Mitarbeiter \"{result.Data.FullName}\" wurde angelegt. Eine E-Mail mit dem Passwort-Reset-Link wurde gesendet.";
                await Task.Delay(4000);
                _successMessage = null;
            }
        }
        else
        {
            _errorMessage = result.ErrorMessage;
        }
    }

    private void CloseAddForm()
    {
        _showAddForm = false;
        _errorMessage = null;
    }

    private async Task HandleRemove(string memberId)
    {
        var result = await TeamDataService.RemoveMemberAsync(memberId);
        if (result.Success)
            _members.RemoveAll(m => m.Id == memberId);
    }
}
