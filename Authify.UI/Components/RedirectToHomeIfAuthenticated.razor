@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

@code {
    [Parameter]
    public string RedirectUrl { get; set; } = "/";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            // Benutzer ist eingeloggt -> Weg hier!
            // mycelis_change - RedirectUrl can point at a plain MVC/API route (e.g. the OIDC
            // /oidc/authorize action used by the Mycelis CLI login flow), which has no matching
            // Blazor @page component. Without forceLoad, Blazor's client-side router intercepts
            // the navigation, fails to match any page, and shows "nothing at this address" -
            // without ever making a real request to the server for that URL.
            NavigationManager.NavigateTo(RedirectUrl, forceLoad: true);
        }
    }
}