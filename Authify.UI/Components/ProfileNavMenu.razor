@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@using Authify.Core.Features
@using Authify.UI.Models
@using Authify.UI.Services
@implements IDisposable
@inject IJSRuntime JS
@inject TeamFeatureOptions TeamFeature
@inject LdapFeatureOptions LdapFeature
@inject ITeamDataService TeamDataService
@inject TeamNavStateService TeamNavState
@inject IEnumerable<IProfileMenuContributor> Contributors
@inject IEnumerable<IProfileMenuPermissionProvider> PermissionProviders

<div class="sidebar-nav">
<div class="auth-space-y-8">

    <div class="nav-group">
        <div class="nav-group-label">
            Account Settings
        </div>
        <div class="auth-space-y-0.5">
            @NavItem("profile-settings", "fa-solid fa-user", "Profile")
            @NavItem("security-settings", "fa-solid fa-shield-halved", "Security")
            @* Everyone gets the privacy page (data export); deactivate/delete are hidden there for team accounts. *@
            @NavItem("privacy-settings", "fa-solid fa-lock", "Privacy")
        </div>
    </div>

    @* Sections that only libraries contribute to (e.g. billing) show up when such a library is active. *@
    @{ var subscriptionItems = ContributedItems(ProfileMenuGroups.Subscription).ToList(); }
    @if (subscriptionItems.Count > 0)
    {
        <div class="nav-group">
            <div class="nav-group-label">
                @ProfileMenuGroups.Subscription
            </div>
            <div class="auth-space-y-0.5">
                @foreach (var item in subscriptionItems)
                {
                    @ContributedNavItem(item)
                }
            </div>
        </div>
    }

    @{ var adminItems = ContributedItems(ProfileMenuGroups.Admin).ToList(); }
    @if ((TeamFeature.IsEnabled && !_isTeamMember) || adminItems.Count > 0)
    {
        <div class="nav-group">
            <div class="nav-group-label">
                @ProfileMenuGroups.Admin
            </div>
            <div class="auth-space-y-0.5">
                @if (TeamFeature.IsEnabled && !_isTeamMember)
                {
                    @NavItem("admin/team-settings", "fa-solid fa-building", "Team-Account")
                    @if (_isTeamAdmin)
                    {
                        @NavItem("admin/team-members", "fa-solid fa-users", "Mitarbeiter")
                        @NavItem("admin/team-invitations", "fa-solid fa-envelope-open-text", "Einladungslinks")
                        @if (LdapFeature.IsEnabled)
                        {
                            @NavItem("admin/ldap", "fa-solid fa-server", "LDAP / Active Directory")
                        }
                    }
                }
                @foreach (var item in adminItems)
                {
                    @ContributedNavItem(item)
                }
            </div>
        </div>
    }

    @foreach (var group in ExtraContributedGroups())
    {
        <div class="nav-group">
            <div class="nav-group-label">
                @group
            </div>
            <div class="auth-space-y-0.5">
                @foreach (var item in ContributedItems(group))
                {
                    @ContributedNavItem(item)
                }
            </div>
        </div>
    }

    </div>
</div>

<div class="sidebar-foot">
    <a href="/dashboard" class="nav-item" style="text-decoration:none;">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Back to Dashboard</span>
    </a>
</div>

@code {
    private bool _isTeamAdmin;
    private bool _isTeamMember;
    private IReadOnlySet<string> _permissions = new HashSet<string>();

    protected override async Task OnInitializedAsync()
    {
        await RefreshTeamStateAsync();
        TeamNavState.OnChange += HandleTeamChanged;
    }

    private async Task RefreshTeamStateAsync()
    {
        if (TeamFeature.IsEnabled)
        {
            try
            {
                var adminResult = await TeamDataService.IsTeamAdminAsync();
                _isTeamAdmin = adminResult.Success && adminResult.Data;

                var memberResult = await TeamDataService.IsTeamMemberAsync();
                // "Mitglied" im Sinne von: nicht-admin Mitglied eines Teams
                _isTeamMember = memberResult.Success && memberResult.Data && !_isTeamAdmin;
            }
            catch
            {
                // Ignorieren falls Service nicht verfügbar
            }
        }

        var permissions = new HashSet<string>(StringComparer.Ordinal);
        foreach (var provider in PermissionProviders)
        {
            try { permissions.UnionWith(await provider.GetPermissionsAsync()); }
            catch { /* a failing provider just contributes nothing */ }
        }
        _permissions = permissions;
    }

    private async void HandleTeamChanged()
    {
        await RefreshTeamStateAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TeamNavState.OnChange -= HandleTeamChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("applyTheme"); } catch { }
        }
    }
    
    private ProfileMenuContext MenuContext => new(_isTeamAdmin, _isTeamMember, TeamFeature.IsEnabled, _permissions);

    private IEnumerable<ProfileMenuItem> VisibleContributedItems()
    {
        var context = MenuContext;
        return Contributors
            .SelectMany(c => c.GetItems())
            .Where(i => i.IsVisible?.Invoke(context) ?? true);
    }

    private IEnumerable<ProfileMenuItem> ContributedItems(string group)
        => VisibleContributedItems()
            .Where(i => string.Equals(i.Group, group, StringComparison.OrdinalIgnoreCase))
            .OrderBy(i => i.Order);

    // Groups other than the built-in ones, in order of first appearance.
    private IEnumerable<string> ExtraContributedGroups()
    {
        var builtIn = new[] { ProfileMenuGroups.AccountSettings, ProfileMenuGroups.Subscription, ProfileMenuGroups.Admin };
        return VisibleContributedItems()
            .Select(i => i.Group)
            .Where(g => !string.IsNullOrWhiteSpace(g) && !builtIn.Contains(g, StringComparer.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase);
    }

    private RenderFragment ContributedNavItem(ProfileMenuItem item) => NavItem(item.Href, item.IconClass, item.Title);

    private RenderFragment NavItem(string href, string icon, string text) => __builder =>
    {
        <NavLink href="@href" Match="NavLinkMatch.Prefix" class="nav-item" ActiveClass="active">
            <i class="@icon"></i>
            <span>@text</span>
        </NavLink>
    };
}
